{
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "functions": {
    "api/fred.js": {
      "maxDuration": 10
    },
    "api/fmp.js": {
      "maxDuration": 10
    },
    "api/phase.js": {
      "maxDuration": 15
    },
    "api/snapshot.js": {
      "maxDuration": 30
    },
    "api/backfill.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/snapshot",
      "schedule": "0 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET" }
      ]
    }
  ]
}
